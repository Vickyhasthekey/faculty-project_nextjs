# Chat (server-only). Search does not need this.
GEMINI_API_KEY=your-gemini-api-key

# Neon Postgres. When set, search/filters read live faculty rows.
# Updates in Neon show up on the next request without redeploying.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Used only by /api/professor, /api/interest, /api/department (the /testing page).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=faculty
MYSQL_SSL=false
