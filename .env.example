# Backend the Next.js API routes proxy to.
# Local:  http://localhost:8000
# Deployed: https://faculty-project-fastapi.onrender.com
FACULTY_API_URL=http://localhost:8000

# Used only by /api/professor, /api/interest, /api/department (the /testing page).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=faculty
# Set to false for local MySQL without TLS. Production (TiDB/cloud) should omit this or set true.
MYSQL_SSL=false
